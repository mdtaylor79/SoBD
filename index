<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#F6F2E0;color:#1A1A1A;font-family:'Source Serif 4',Cambria,Georgia,serif;font-size:16px;line-height:1.55}
header{background:#1A1A1A;color:#F6F2E0;position:relative;overflow:hidden}
